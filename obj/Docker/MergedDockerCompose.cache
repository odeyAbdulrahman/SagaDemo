name: dockercompose12794200389033673952
services:
  inventoryservice:
    build:
      context: D:\Programing\git\api\SagaDemo
      dockerfile: InventoryService/Dockerfile
    container_name: inventoryservice
    depends_on:
      rabbitmq:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:80
      RabbitMQ__Host: rabbitmq
      RabbitMQ__Password: guest
      RabbitMQ__Username: guest
    image: inventoryservice
    networks:
      saganet: null
    ports:
      - mode: ingress
        target: 80
        published: "8004"
        protocol: tcp
    restart: unless-stopped
  orderservice:
    build:
      context: D:\Programing\git\api\SagaDemo
      dockerfile: OrderService/Dockerfile
    container_name: orderservice
    depends_on:
      rabbitmq:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:80
      RabbitMQ__Host: rabbitmq
      RabbitMQ__Password: guest
      RabbitMQ__Username: guest
    image: orderservice
    networks:
      saganet: null
    ports:
      - mode: ingress
        target: 80
        published: "8002"
        protocol: tcp
    restart: unless-stopped
  paymentservice:
    build:
      context: D:\Programing\git\api\SagaDemo
      dockerfile: PaymentService/Dockerfile
    container_name: paymentservice
    depends_on:
      rabbitmq:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:80
      DOTNET_RUNNING_IN_CONTAINER: "true"
      RabbitMQ__Host: rabbitmq
      RabbitMQ__Password: guest
      RabbitMQ__Username: guest
    image: paymentservice
    networks:
      saganet: null
    ports:
      - mode: ingress
        target: 80
        published: "8003"
        protocol: tcp
    restart: unless-stopped
  rabbitmq:
    container_name: rabbitmq
    environment:
      RABBITMQ_DEFAULT_PASS: guest
      RABBITMQ_DEFAULT_USER: guest
    healthcheck:
      test:
        - CMD
        - rabbitmqctl
        - status
      timeout: 5s
      interval: 10s
      retries: 5
    image: rabbitmq:3-management
    networks:
      saganet: null
    ports:
      - mode: ingress
        target: 5672
        published: "5672"
        protocol: tcp
      - mode: ingress
        target: 15672
        published: "15672"
        protocol: tcp
  sagaorchestrator:
    build:
      context: D:\Programing\git\api\SagaDemo
      dockerfile: SagaOrchestrator/Dockerfile
    container_name: sagaorchestrator
    depends_on:
      rabbitmq:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:80
      RabbitMQ__Host: rabbitmq
      RabbitMQ__Password: guest
      RabbitMQ__Username: guest
    image: sagaorchestrator
    networks:
      saganet: null
    ports:
      - mode: ingress
        target: 80
        published: "8001"
        protocol: tcp
    restart: unless-stopped
networks:
  saganet:
    name: dockercompose12794200389033673952_saganet
    driver: bridge