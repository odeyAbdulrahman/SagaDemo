## Standard .NET Core gitignore
## https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build outputs
[Bb]in/
[Oo]bj/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/
[Bb]uild[Bb]in/

# Visual Studio files
.vs/
.vscode/
*.suo
*.user
*.userprefs
*.userosscache
*.sln.docstates

# MSBuild files
*.binlog
*.log
*.msbuildlog
*.msbuildsuo

# NuGet
[Nn]u[Pp]ackages/
*.nupkg
*.snupkg
packages/

# Project specific
artifacts/
TestResults/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
*.vspscc
*.vssscc

# IDE specific
.idea/

